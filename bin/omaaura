#!/bin/sh
# omaaura — CLI wrapper for OmaAura (v2, Rust).
#
# Resolves the compiled binary next to this script (installed layout) or in the
# repository `target/release` (dev layout), then execs it. No Python involved.
set -eu

SELF="$(readlink -f "$0")"
DIR="$(dirname "$SELF")"

for candidate in \
  "$DIR/omaaura-bin" \
  "$DIR/../target/release/omaaura" \
  "$DIR/../target/debug/omaaura"; do
  if [ -x "$candidate" ]; then
    exec "$candidate" "$@"
  fi
done

echo "omaaura: compiled binary not found. Build it with 'cargo build --release' or run ./install.sh" >&2
exit 127
