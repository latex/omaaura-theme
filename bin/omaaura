#!/usr/bin/env python3
"""Unified CLI entrypoint for OmaAura.

Handles theme synchronization, hardware control (I2C ENE Aura & OpenRGB),
palette generation, status inspection, and background daemon execution.
"""

import argparse
import fcntl
import json
import os
import sys
import time
from pathlib import Path
from typing import Any, Dict, Optional

# Ensure the omaaura package root is importable
SCRIPT_PATH = Path(__file__).resolve()
PACKAGE_ROOT = SCRIPT_PATH.parent.parent
if str(PACKAGE_ROOT) not in sys.path:
    sys.path.insert(0, str(PACKAGE_ROOT))

from omaaura.cli.setup import run_setup
from omaaura.core.color import calibrate_hex
from omaaura.core.config import load_config
from omaaura.core.hardware import (
    detect_all_hardware,
    set_ene_color,
    set_openrgb_color,
)

# Paths and state management
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "omaaura-theme"
STATE_FILE = STATE_DIR / "state"
LOCK_FILE = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "omaaura-theme.lock"
THEME_COLOR_FILE = Path.home() / ".local/state/omarchy/current/theme/keyboard.rgb"
THEME_COLORS_TOML = Path.home() / ".local/state/omarchy/current/theme/colors.toml"


def _ensure_state_dir() -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)


def calibrate_color(hex_code: str, config: Optional[Dict[str, Any]] = None) -> str:
    """Apply the LED calibration (single source of truth for hardware colors).

    Screen sRGB and additive LEDs perceive the same hex differently: pastel
    colors look "washed out / whitish" on LEDs.  This boosts saturation (and
    value) so the physical LED matches the swatch shown in the widget.
    """
    if config is None:
        config = load_config()

    clean = hex_code.lstrip("#").strip()
    theme = config.get("theme", {})

    enabled = theme.get("calibrate_led", theme.get("normalize_brightness", True))
    if not enabled:
        return clean

    return calibrate_hex(
        clean,
        saturation_floor=float(theme.get("saturation_floor", 0.70)),
        value_target=float(theme.get("value_target", 1.0)),
        fallback=theme.get("fallback_color", "89b4fa"),
    )


def get_theme_color(config: Optional[Dict[str, Any]] = None) -> str:
    """Read the *raw* active Omarchy theme accent color (no LED calibration)."""
    if config is None:
        config = load_config()

    fallback = config.get("theme", {}).get("fallback_color", "89b4fa")
    hex_color = ""

    if THEME_COLOR_FILE.exists():
        try:
            raw = THEME_COLOR_FILE.read_text().strip().lstrip("#")
            if len(raw) == 6 and all(c in "0123456789abcdefABCDEF" for c in raw):
                hex_color = raw
        except Exception:
            pass

    if not hex_color and THEME_COLORS_TOML.exists():
        try:
            import tomllib
            data = tomllib.loads(THEME_COLORS_TOML.read_text())
            accent = data.get("accent", "")
            if isinstance(accent, str) and accent.startswith("#") and len(accent) == 7:
                hex_color = accent.lstrip("#")
        except Exception:
            pass

    return hex_color or fallback


def apply_color(hex_str: str, config: Optional[Dict[str, Any]] = None) -> bool:
    """Apply the specified hex color across all configured hardware backends.

    The color is calibrated here (single point) so the value written to the
    state file — and therefore shown by the widget icon — is exactly the color
    the hardware received.
    """
    if config is None:
        config = load_config()

    clean_hex = hex_str.lstrip("#").strip()
    applied_hex = calibrate_color(clean_hex, config)
    _ensure_state_dir()

    with open(LOCK_FILE, "w") as lock_fd:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except (BlockingIOError, OSError):
            # Another process holds the lock; wait until it is released.
            fcntl.flock(lock_fd, fcntl.LOCK_EX)

        try:
            hw = config.get("hardware", {})
            ok = True

            # 1. Motherboard, ARGB fans & RAM Backend (OpenRGB, GPU excluded).
            # Runs first so the GPU, written last via direct I2C, always wins.
            if hw.get("motherboard_backend") == "openrgb":
                openrgb_devs = hw.get("openrgb_devices", "all")
                try:
                    if not set_openrgb_color(applied_hex, device_ids=openrgb_devs):
                        print("Warning: OpenRGB color write failed", file=sys.stderr)
                        ok = False
                except Exception as ex:
                    print(f"Warning: Failed to set OpenRGB color: {ex}", file=sys.stderr)
                    ok = False

            # 2. GPU Backend (ENE Aura direct I2C)
            if hw.get("gpu_backend") == "ene_i2c":
                dev_path = hw.get("gpu_i2c_bus", "/dev/i2c-1")
                addr = hw.get("gpu_i2c_addr", 0x67)
                try:
                    if not set_ene_color(applied_hex, dev_path=dev_path, addr=addr):
                        print(
                            f"Warning: GPU ENE write skipped ({dev_path} not available)",
                            file=sys.stderr,
                        )
                        ok = False
                except Exception as ex:
                    print(f"Warning: Failed to set GPU ENE color: {ex}", file=sys.stderr)
                    ok = False

            STATE_FILE.write_text(f"on:#{applied_hex}\n")
            return ok
        finally:
            fcntl.flock(lock_fd, fcntl.LOCK_UN)


def turn_off(config: Optional[Dict[str, Any]] = None) -> bool:
    """Turn off all hardware LEDs."""
    if config is None:
        config = load_config()

    _ensure_state_dir()

    with open(LOCK_FILE, "w") as lock_fd:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX)
            hw = config.get("hardware", {})

            if hw.get("gpu_backend") == "ene_i2c":
                dev_path = hw.get("gpu_i2c_bus", "/dev/i2c-1")
                addr = hw.get("gpu_i2c_addr", 0x67)
                try:
                    set_ene_color("000000", dev_path=dev_path, addr=addr)
                except Exception:
                    pass

            if hw.get("motherboard_backend") == "openrgb":
                openrgb_devs = hw.get("openrgb_devices", "all")
                try:
                    set_openrgb_color("000000", device_ids=openrgb_devs)
                except Exception:
                    pass

            STATE_FILE.write_text("off\n")
            return True
        finally:
            fcntl.flock(lock_fd, fcntl.LOCK_UN)


def toggle(config: Optional[Dict[str, Any]] = None) -> None:
    """Toggle LEDs between active theme color and off."""
    if config is None:
        config = load_config()

    current_state = "unknown"
    if STATE_FILE.exists():
        current_state = STATE_FILE.read_text().strip()

    if current_state.startswith("off"):
        color = get_theme_color(config)
        apply_color(color, config)
    else:
        turn_off(config)


def get_status(config: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
    """Inspect current OmaAura status."""
    if config is None:
        config = load_config()

    color = calibrate_color(get_theme_color(config), config)
    current_state = "unknown"
    if STATE_FILE.exists():
        current_state = STATE_FILE.read_text().strip()

    return {
        "theme_color": f"#{color}",
        "led_state": current_state,
        "gpu_backend": config.get("hardware", {}).get("gpu_backend"),
        "motherboard_backend": config.get("hardware", {}).get("motherboard_backend"),
    }


def export_palette() -> None:
    """Generate color palette JSON for Quickshell BarWidget."""
    # Delegate to get-palette script or embedded logic
    palette_script = PACKAGE_ROOT / "bin" / "get-palette.py"
    if palette_script.exists():
        os.execv(sys.executable, [sys.executable, str(palette_script)])
    else:
        print(json.dumps({"theme": [], "background": []}))


def run_daemon() -> None:
    """Background monitoring daemon for theme color changes."""
    config = load_config()
    interval = config.get("service", {}).get("poll_interval_sec", 2.0)

    last_color = None
    print(f"OmaAura daemon started (poll interval: {interval}s)...")

    # Initial sync
    initial_color = get_theme_color(config)
    apply_color(initial_color, config)
    last_color = initial_color

    while True:
        try:
            time.sleep(interval)
            current_color = get_theme_color(config)
            if current_color != last_color:
                # Check if user explicitly turned off LEDs; don't force on unless theme actually changed
                apply_color(current_color, config)
                last_color = current_color
                print(f"[OmaAura] Theme color updated: #{current_color}")
        except KeyboardInterrupt:
            print("Daemon exiting...")
            break
        except Exception as e:
            print(f"[OmaAura] Daemon loop error: {e}", file=sys.stderr)
            time.sleep(interval)


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="omaaura",
        description="OmaAura: ASUS Aura hardware LED & Omarchy theme synchronization.",
    )
    subparsers = parser.add_subparsers(dest="command", help="Available subcommands")

    # sync
    subparsers.add_parser("sync", help="Synchronize LEDs with current Omarchy theme")

    # set
    set_parser = subparsers.add_parser("set", help="Set a specific RGB hexadecimal color")
    set_parser.add_argument("hex", help="Hex color code (e.g. ff0055, #89b4fa)")

    # off
    subparsers.add_parser("off", help="Turn off all hardware LEDs")

    # toggle
    subparsers.add_parser("toggle", help="Toggle LEDs on/off")

    # status
    subparsers.add_parser("status", help="Show current hardware and theme status")

    # setup
    setup_parser = subparsers.add_parser("setup", help="Run interactive hardware setup wizard")
    setup_parser.add_argument("-y", "--yes", action="store_true", help="Non-interactive setup")

    # test-hardware
    subparsers.add_parser("test-hardware", help="Inspect and test hardware I2C and OpenRGB")

    # palette
    subparsers.add_parser("palette", help="Output theme and wallpaper palette JSON")

    # daemon
    subparsers.add_parser("daemon", help="Run as background sync daemon")

    args = parser.parse_args()

    # Default action if no argument is provided: sync
    if args.command is None or args.command == "sync":
        config = load_config()
        color = get_theme_color(config)
        applied = calibrate_color(color, config)
        apply_color(color, config)
        print(f"OmaAura: Applied theme color #{applied} (from #{color})")
    elif args.command == "set":
        config = load_config()
        hex_val = args.hex.lstrip("#")
        if len(hex_val) != 6:
            print(f"Error: Invalid hex color '{args.hex}'. Use format RRGGBB.", file=sys.stderr)
            sys.exit(1)
        applied = calibrate_color(hex_val, config)
        apply_color(hex_val, config)
        print(f"OmaAura: Applied color #{applied} (from #{hex_val})")
    elif args.command == "off":
        turn_off()
        print("OmaAura: LEDs turned off.")
    elif args.command == "toggle":
        toggle()
    elif args.command == "status":
        st = get_status()
        print(f"Tema atual (normalizado): {st['theme_color']}")
        print(f"Estado LEDs: {st['led_state']}")
        print(f"GPU Backend: {st['gpu_backend']}")
        print(f"Motherboard Backend: {st['motherboard_backend']}")
    elif args.command == "setup":
        run_setup(interactive=not args.yes)
    elif args.command == "test-hardware":
        diag = detect_all_hardware()
        print(json.dumps(diag, indent=2))
    elif args.command == "palette":
        export_palette()
    elif args.command == "daemon":
        run_daemon()


if __name__ == "__main__":
    main()
