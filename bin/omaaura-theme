#!/bin/bash
# omaaura-theme CLI & backend helper
# Synchronizes ASUS Aura hardware LEDs (Motherboard ROG B550-F, ARGB Cabinet Fans/Strips, GPU RTX 5060 Ti) with the active Omarchy theme.

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omaaura-theme"
mkdir -p "$STATE_DIR"
STATE_FILE="$STATE_DIR/state"
LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/omaaura-theme.lock"

THEME_COLOR_FILE="$HOME/.local/state/omarchy/current/theme/keyboard.rgb"
THEME_COLORS_TOML="$HOME/.local/state/omarchy/current/theme/colors.toml"
PROFILE_PATH="$HOME/.config/OpenRGB/profiles/default.json"

get_theme_color() {
  local hex=""
  if [[ -f "$THEME_COLOR_FILE" ]]; then
    hex=$(sed 's/^#//' "$THEME_COLOR_FILE" | tr -d ' \n\r')
  fi
  if [[ ! $hex =~ ^[0-9A-Fa-f]{6}$ ]] && [[ -f "$THEME_COLORS_TOML" ]]; then
    hex=$(grep -E '^\s*accent\s*=' "$THEME_COLORS_TOML" | sed -E 's/.*"#[0-9A-Fa-f]{6}".*/\0/' | sed -E 's/.*#([0-9A-Fa-f]{6}).*/\1/')
  fi
  if [[ ! $hex =~ ^[0-9A-Fa-f]{6}$ ]]; then
    hex="89b4fa"
  fi

  # Normaliza para brilho maximo (V=1.0 no espaco HSV)
  local bright_hex
  bright_hex=$(python3 -c "
import sys, colorsys
hex_c = '$hex'
r, g, b = int(hex_c[0:2], 16)/255.0, int(hex_c[2:4], 16)/255.0, int(hex_c[4:6], 16)/255.0
h, s, v = colorsys.rgb_to_hsv(r, g, b)
if s < 0.05:
    print('ffffff')
else:
    r_f, g_f, b_f = colorsys.hsv_to_rgb(h, s, 1.0)
    print(f'{int(round(r_f*255)):02x}{int(round(g_f*255)):02x}{int(round(b_f*255)):02x}')
" 2>/dev/null)

  if [[ $bright_hex =~ ^[0-9A-Fa-f]{6}$ ]]; then
    echo "$bright_hex"
  else
    echo "$hex"
  fi
}

apply_color() {
  local hex="$1"
  if ! command -v openrgb >/dev/null 2>&1; then
    echo "Erro: openrgb não está instalado. Instale com: omarchy pkg add openrgb" >&2
    exit 1
  fi
  (
    flock -w 10 200 || exit 1

    mkdir -p "$(dirname "$PROFILE_PATH")"
    if [[ ! -f "$PROFILE_PATH" ]]; then
      openrgb -d "ASUS ROG STRIX B550-F GAMING WIFI II" -z 1 -sz 120 -c "$hex" >/dev/null 2>&1
      openrgb --save-profile default >/dev/null 2>&1
    fi

    python3 -c "
import json, sys
color_int = int('$hex', 16)
p = '$PROFILE_PATH'
try:
    with open(p, 'r') as f:
        d = json.load(f)
    for c in d['controllers']:
        c['colors'] = [color_int] * len(c['colors'])
    with open(p, 'w') as f:
        json.dump(d, f, indent=4)
except Exception:
    sys.exit(1)
"
    # Aplica o perfil sincronizado em um único envio atômico
    openrgb -p default >/dev/null 2>&1
    echo "on:#$hex" > "$STATE_FILE"
  ) 200>"$LOCK_FILE"
}

turn_off() {
  if ! command -v openrgb >/dev/null 2>&1; then
    exit 1
  fi
  (
    flock -w 10 200 || exit 1
    python3 -c "
import json, sys
p = '$PROFILE_PATH'
try:
    with open(p, 'r') as f:
        d = json.load(f)
    for c in d['controllers']:
        c['colors'] = [0] * len(c['colors'])
    with open(p, 'w') as f:
        json.dump(d, f, indent=4)
except Exception:
    sys.exit(1)
"
    openrgb -p default >/dev/null 2>&1
    echo "off" > "$STATE_FILE"
  ) 200>"$LOCK_FILE"
}

case "$1" in
  sync|"")
    color=$(get_theme_color)
    apply_color "$color"
    ;;
  set)
    hex="${2#\#}"
    if [[ $hex =~ ^[0-9A-Fa-f]{6}$ ]]; then
      apply_color "$hex"
    else
      echo "Cor inválida. Use formato RRGGBB (ex: 89b4fa)." >&2
      exit 1
    fi
    ;;
  off)
    turn_off
    ;;
  toggle)
    current_state=$(cat "$STATE_FILE" 2>/dev/null || echo "unknown")
    if [[ "$current_state" == off* ]]; then
      color=$(get_theme_color)
      apply_color "$color"
    else
      turn_off
    fi
    ;;
  status)
    color=$(get_theme_color)
    current_state=$(cat "$STATE_FILE" 2>/dev/null || echo "unknown")
    echo "Tema atual (normalizado): #$color"
    echo "Estado LEDs: $current_state"
    ;;
  *)
    echo "Uso: $0 {sync|set <HEX>|off|toggle|status}"
    exit 1
    ;;
esac
