#!/bin/bash
# omaaura-theme CLI & backend helper
# Synchronizes ASUS Aura hardware LEDs (Motherboard ROG B550-F, ARGB Cabinet Fans/Strips, GPU TUF RTX 5060 Ti) with the active Omarchy theme.

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omaaura-theme"
mkdir -p "$STATE_DIR"
STATE_FILE="$STATE_DIR/state"
LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/omaaura-theme.lock"

THEME_COLOR_FILE="$HOME/.local/state/omarchy/current/theme/keyboard.rgb"
THEME_COLORS_TOML="$HOME/.local/state/omarchy/current/theme/colors.toml"

get_theme_color() {
  local hex=""
  if [[ -f "$THEME_COLOR_FILE" ]]; then
    hex=$(sed 's/^#//' "$THEME_COLOR_FILE" | tr -d ' \n\r')
  fi
  if [[ ! $hex =~ ^[0-9A-Fa-f]{6}$ ]] && [[ -f "$THEME_COLORS_TOML" ]]; then
    hex=$(grep -E '^\s*accent\s*=' "$THEME_COLORS_TOML" | sed -E 's/.*"#[0-9A-Fa-f]{6}".*/\0/' | sed -E 's/.*#([0-9A-Fa-f]{6}).*/\1/')
  fi
  if [[ ! $hex =~ ^[0-9A-Fa-f]{6}$ ]]; then
    hex="89b4fa"
  fi

  # Normaliza para brilho máximo (V=1.0 no espaço HSV)
  local bright_hex
  bright_hex=$(python3 -c "
import sys, colorsys
hex_c = '$hex'
r, g, b = int(hex_c[0:2], 16)/255.0, int(hex_c[2:4], 16)/255.0, int(hex_c[4:6], 16)/255.0
h, s, v = colorsys.rgb_to_hsv(r, g, b)
if s < 0.05:
    print('ffffff')
else:
    r_f, g_f, b_f = colorsys.hsv_to_rgb(h, s, 1.0)
    print(f'{int(round(r_f*255)):02x}{int(round(g_f*255)):02x}{int(round(b_f*255)):02x}')
" 2>/dev/null)

  if [[ $bright_hex =~ ^[0-9A-Fa-f]{6}$ ]]; then
    echo "$bright_hex"
  else
    echo "$hex"
  fi
}

apply_gpu_color() {
  local hex="$1"
  python3 -c "
import os, fcntl, ctypes, time

def set_gpu(hex_str):
    try:
        r, g, b = int(hex_str[0:2], 16), int(hex_str[2:4], 16), int(hex_str[4:6], 16)
        dev_path = '/dev/i2c-1'
        if not os.path.exists(dev_path):
            return
        fd = os.open(dev_path, os.O_RDWR)
        fcntl.ioctl(fd, 0x0703, 0x67)

        class smbus_data(ctypes.Union):
            _fields_ = [('byte', ctypes.c_uint8), ('word', ctypes.c_uint16), ('block', ctypes.c_uint8 * 34)]

        class smbus_ioctl(ctypes.Structure):
            _fields_ = [('rw', ctypes.c_uint8), ('cmd', ctypes.c_uint8), ('size', ctypes.c_uint32), ('data', ctypes.POINTER(smbus_data))]

        def w_word(cmd, val):
            d = smbus_data(word=val)
            fcntl.ioctl(fd, 0x0720, smbus_ioctl(0, cmd, 3, ctypes.pointer(d)))

        def w_byte(cmd, val):
            d = smbus_data(byte=val)
            fcntl.ioctl(fd, 0x0720, smbus_ioctl(0, cmd, 2, ctypes.pointer(d)))

        def ene_w(reg, val):
            w_word(0x00, ((reg << 8) & 0xFF00) | ((reg >> 8) & 0x00FF))
            w_byte(0x01, val)

        mode = 1 if (r > 0 or g > 0 or b > 0) else 0
        ene_w(0x8021, mode)
        ene_w(0x8022, 2)
        ene_w(0x8023, 0)
        ene_w(0x8020, 0)

        for led in range(4):
            # V2 registers (0x8160 effect, 0x8100 direct)
            ene_w(0x8160 + (3 * led) + 0, r)
            ene_w(0x8160 + (3 * led) + 1, b)
            ene_w(0x8160 + (3 * led) + 2, g)
            ene_w(0x8100 + (3 * led) + 0, r)
            ene_w(0x8100 + (3 * led) + 1, b)
            ene_w(0x8100 + (3 * led) + 2, g)
            # V1 registers (0x8010 effect, 0x8000 direct)
            ene_w(0x8010 + (3 * led) + 0, r)
            ene_w(0x8010 + (3 * led) + 1, b)
            ene_w(0x8010 + (3 * led) + 2, g)
            ene_w(0x8000 + (3 * led) + 0, r)
            ene_w(0x8000 + (3 * led) + 1, b)
            ene_w(0x8000 + (3 * led) + 2, g)

        ene_w(0x80A0, 0x01)
        time.sleep(0.02)
        ene_w(0x80A0, 0xAA)
        os.close(fd)
    except Exception:
        pass

set_gpu('$hex')
" 2>/dev/null
}

apply_color() {
  local hex="$1"
  if ! command -v openrgb >/dev/null 2>&1; then
    echo "Erro: openrgb não está instalado. Instale com: omarchy pkg add openrgb" >&2
    exit 1
  fi
  (
    flock -w 10 200 || exit 1
    # 1. Aplica na GPU (ASUS TUF RTX 5060 Ti via I2C ENE SMBus direto)
    apply_gpu_color "$hex"
    # 2. Aplica exclusivamente na Placa-mãe ROG B550-F e Gabinete ARGB com 120 LEDs (Device 1)
    openrgb -d 1 -c "$hex" >/dev/null 2>&1
    echo "on:#$hex" > "$STATE_FILE"
  ) 200>"$LOCK_FILE"
}

turn_off() {
  if ! command -v openrgb >/dev/null 2>&1; then
    exit 1
  fi
  (
    flock -w 10 200 || exit 1
    apply_gpu_color "000000"
    openrgb -d 1 -c 000000 >/dev/null 2>&1
    echo "off" > "$STATE_FILE"
  ) 200>"$LOCK_FILE"
}

case "$1" in
  sync|"")
    color=$(get_theme_color)
    apply_color "$color"
    ;;
  set)
    hex="${2#\#}"
    if [[ $hex =~ ^[0-9A-Fa-f]{6}$ ]]; then
      apply_color "$hex"
    else
      echo "Cor inválida. Use formato RRGGBB (ex: 89b4fa)." >&2
      exit 1
    fi
    ;;
  off)
    turn_off
    ;;
  toggle)
    current_state=$(cat "$STATE_FILE" 2>/dev/null || echo "unknown")
    if [[ "$current_state" == off* ]]; then
      color=$(get_theme_color)
      apply_color "$color"
    else
      turn_off
    fi
    ;;
  status)
    color=$(get_theme_color)
    current_state=$(cat "$STATE_FILE" 2>/dev/null || echo "unknown")
    echo "Tema atual (normalizado): #$color"
    echo "Estado LEDs: $current_state"
    ;;
  *)
    echo "Uso: $0 {sync|set <HEX>|off|toggle|status}"
    exit 1
    ;;
esac
