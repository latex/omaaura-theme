#!/bin/bash
# Hook: theme-set
# Dynamically synchronizes Hardware LEDs with active Omarchy theme.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ -x "$SCRIPT_DIR/bin/omaaura-theme" ]]; then
  "$SCRIPT_DIR/bin/omaaura-theme" sync >/dev/null 2>&1 &
elif command -v omaaura-theme >/dev/null 2>&1; then
  omaaura-theme sync >/dev/null 2>&1 &
fi
