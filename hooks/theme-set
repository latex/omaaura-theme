#!/bin/bash
# Hook: theme-set
# Sincroniza os LEDs de hardware com o tema Omarchy ativo.
# Instalado por install.sh em ~/.config/omarchy/hooks/theme-set.d/omaaura-theme.sh
#
# Resolve o CLI nesta ordem: ~/.local/bin -> pasta do plugin -> PATH.
# Sem id hardcoded, para sobreviver a mudanças de namespace do plugin.

PLUGIN_ID="io.github.latex.omaaura-theme"

for bin in \
  "$HOME/.local/bin/omaaura" \
  "$HOME/.config/omarchy/plugins/$PLUGIN_ID/bin/omaaura"; do
  if [[ -x "$bin" ]]; then
    "$bin" sync >/dev/null 2>&1 &
    exit 0
  fi
done

if command -v omaaura >/dev/null 2>&1; then
  omaaura sync >/dev/null 2>&1 &
fi
