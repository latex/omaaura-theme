[Unit]
Description=OmaAura - ASUS Hardware LED Sync Service for Omarchy
Documentation=https://github.com/latex/omaaura-theme
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/omaaura daemon
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=graphical-session.target
